[Unit]
Description=RoboComp victron
StartLimitIntervalSec=0


[Service]
Type=simple
User=orangepi
Group=orangepi
SupplementaryGroups=dialout
WorkingDirectory=/home/orangepi/robocomp/components/robocomp-robolab/components/hardware/battery/victron
Environment=ROBOCOMP=/home/orangepi/robocomp
Environment=PATH=/home/orangepi/software/pip_venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=QT_QPA_PLATFORM=offscreen
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/orangepi/robocomp/components/robocomp-robolab/components/hardware/battery/victron/src
ExecStart=/home/orangepi/software/pip_venv/bin/python /home/orangepi/robocomp/components/robocomp-robolab/components/hardware/battery/victron/bin/victron etc/config
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
