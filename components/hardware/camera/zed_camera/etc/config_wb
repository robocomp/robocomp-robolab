
# This property is used by the clients to connect to IceStorm.
Proxies.TopicManager = "IceStorm/TopicManager:default -p 9999"

# Proxies for publishes interfaces
Proxies.FullPoseEstimationPubPrefix = "zed"
Proxies.CameraRGBDSimplePubPrefix = ""
Proxies.IMUPubPrefix = ""

# Proxies for required interfaces
Proxies.CameraRGBDSimple = "camerargbdsimple:tcp -h localhost -p 10009"

# Endpoints for implements interfaces
Endpoints.CameraRGBDSimple = "tcp -p 12001"
Endpoints.Lidar3D = "tcp -p 12000"

Period.Compute = 1
Period.Emergency = 500

Config.Simulated = True
Config.Display = True
Config.Publish = False
# ZED SDK depth engine (sl::DEPTH_MODE). Only used when Simulated = false. From
# lightest/fastest to heaviest/most accurate:
#   PERFORMANCE  - deprecated classical stereo matching, optimized for speed
#   QUALITY      - deprecated classical stereo matching, better on low-texture surfaces
#   ULTRA        - deprecated classical stereo matching, favors edges/sharpness, more GPU memory
#   NEURAL_LIGHT - neural disparity estimation, lightest neural option (needs AI module)
#   NEURAL       - neural disparity estimation, balanced accuracy/cost (needs AI module)
#   NEURAL_PLUS  - neural disparity estimation, most accurate, heaviest GPU/CPU cost (needs AI module)
Config.DepthMode = "NEURAL_PLUS"

Component.Debug.Verbose = true

Ice.Warn.Connections = "0"
Ice.Trace.Network = "0"
Ice.Trace.Protocol = "0"
Ice.MessageSizeMax = "20004800"
