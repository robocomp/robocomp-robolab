### Lidar params ###
# RSHELIOS=0   RSBPEARL=1
lidar_model = 0
dest_pc_ip_addr = "192.168.50.210"
msop_port = 6699
difop_port = 7788
simulator = false

#Warning use "." for decimals not ","
rx = 0.0
ry = 0.0
rz = 0.0
tx = 0.0
ty = -170.0
tz = 1100.0

Period.Compute = 50
