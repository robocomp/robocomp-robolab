# Endpoints for implements interfaces
Endpoints.Lidar3D = "tcp -p 11990"
Endpoints.MediaPlaneDDS = "tcp -p 11890"

# Proxies for required interfaces
Proxies.Lidar3D = "lidar3d:tcp -h localhost -p 11988"

# Robot-body self-filter (Embree). Removes lidar points hitting the static robot mesh.
MeshFilter.enabled = true
Robot.name = "Shadow"
Floor.z = 110.0
Top.z = 2100.0
Dilate = 0.05
# Robot-frame footprint disc: drops base/wheels/arm returns the STL doesn't model.
# radius in metres, z-band in mm. radius = 0 disables. Safe: inside the robot's own
# footprint nothing is a real obstacle.
Footprint.radius = 0.55
Footprint.z_min = 110.0
Footprint.z_max = 1350.0
# Wider near-floor skirt (low z-band): catches near-floor self/reflection returns past
# the body footprint without hiding upright obstacles (their returns above z_max stay).
Skirt.radius = 0.75
Skirt.z_min = 110.0
Skirt.z_max = 600.0

### Lidar params ###
# RSHELIOS=0   RSBPEARL=1
lidar_model = 0
dest_pc_ip_addr = "192.168.50.210"
msop_port = 6699
difop_port = 7788
simulator = true

# DDS lidar media plane (zero-copy LidarFrame). Metadata is advertised into DSR by
# the robot_concept agent, not here.
PublishDDS = true
DDS.Domain = 7
DDS.Topic = "rc/lidar3d/points"
DDS.HistoryDepth = 2   # 8->2: real-time media plane, shallow history (DDS_SHADOW.md sec 2.2)
DDS.SharedMemoryOnly = true
DDS.DataSharing = false

#Warning use "." for decimals not ","
rx = -0.0
ry = 0.0
rz = 0.0
tx = 0.0
ty = -155.0
tz = 1030.0	 #970.0

Period.Compute = 50
Period.Emergency = 500

Ice.Warn.Connections = "0"
Ice.Trace.Network = "0"
Ice.Trace.Protocol = "0"
Ice.MessageSizeMax = "20004800"
Component.Debug.Verbose = true

### Sensor model advertised with the media plane ###
# Beam geometry and range noise, published in the MediaDescriptor JSON that robot_concept
# relays onto the `helios` DSR node. The driver owns these numbers because it owns the
# sensor; without them every consumer re-asserts its own constants and the two can drift
# apart with nothing to make them disagree loudly.
#
# ★ SOURCE = "simulated": these describe the WEBOTS sensor, taken from the Lidar node in
#   webots-p3bot/protos/P3Bot.proto, NOT from an RS-Helios datasheet and NOT measured on
#   hardware. A consumer is entitled to know which of those it is getting.
# ★ Delete this block to advertise nothing. Absent means UNKNOWN, which the schema defines
#   as "consumer keeps its own constant" — never as zero.
# ★ Extrinsics are NOT here: where the lidar sits is the RT tree (and rx/ry/rz, tx/ty/tz
#   above). Frame only NAMES the frame these intrinsics are expressed in.
SensorModel.Version = 1
SensorModel.Source = "simulated"
SensorModel.Ref = "webots-p3bot/protos/P3Bot.proto Lidar 'helios' (RS-Helios H32F70 stand-in)"
SensorModel.Frame = "helios"

# horizontalResolution 900 over fieldOfView 6.28 rad => 360/900
SensorModel.Rings = 32
SensorModel.AzimuthStepDeg = 0.4
SensorModel.RateHz = 20.0
SensorModel.RangeMaxM = 8.0
# Vertical span as the proto itself states it: 70 deg of FOV in 32 beams with tiltAngle
# -0.34, giving -54.5..+15.5. Keeping the proto's own arithmetic rather than redoing it.
SensorModel.FovStartDeg = -54.5
SensorModel.FovEndDeg = 15.5
#
# ⚠ SensorModel.RingElevDeg is deliberately NOT set. A real H32F70 reports a per-channel
# vertical-angle TABLE in its difop packet, and it is not uniform; Webots' exact placement
# of 32 layers across the span (fov/n vs fov/(n-1)) is not something this file should
# assert from the outside. Absent is the honest answer and costs a consumer nothing it
# was not already assuming. Fill it from the device when running on real hardware.
#
# Webots Lidar `noise 0.005` is a fraction of maxRange => 0.005 * 8 m = 0.04 m, a
# range-INDEPENDENT floor. Hence no proportional term: the simulator has none to report.
SensorModel.RangeSigmaFloorM = 0.04
