[Unit]
Description=RoboComp ledStrip
StartLimitIntervalSec=0

[Service]
Type=simple
User=orangepi
Group=orangepi
SupplementaryGroups=gpio spi
WorkingDirectory=/home/orangepi/robocomp/components/robocomp-robolab/components/hardware/led/ledStrip
Environment=ROBOCOMP=/home/orangepi/robocomp
Environment=PATH=/home/orangepi/software/pip_venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=QT_QPA_PLATFORM=offscreen
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/orangepi/software/pip_venv/bin/python /home/orangepi/robocomp/components/robocomp-robolab/components/hardware/led/ledStrip/bin/ledStrip etc/config
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
